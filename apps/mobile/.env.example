# Public (bundled into the app) — never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Optional: Supabase Auth for accounts / sync (anon key is public by design; RLS not used — the API verifies JWTs).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Build-time only (app.config.ts):
GOOGLE_MAPS_ANDROID_KEY=
EAS_PROJECT_ID=
