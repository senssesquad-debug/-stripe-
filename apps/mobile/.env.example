# Public (bundled into the app) — never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Public address of the web app, used in shared links (defaults to the page origin on the web).
EXPO_PUBLIC_WEB_URL=https://passtra.onrender.com
# Build-time only (app.config.ts):
GOOGLE_MAPS_ANDROID_KEY=
EAS_PROJECT_ID=
# Host whose /event/* and /place/* links open the installed app (Universal Links / App Links).
APP_LINK_HOST=passtra.onrender.com
