{
  "name": "@passtra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "node build.mjs",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:sources": "tsx src/scripts/register-sources.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "dev:token": "tsx src/scripts/dev-token.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@passtra/core": "workspace:*",
    "expo-server-sdk": "^8.0.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "luxon": "^3.7.2",
    "opening_hours": "^3.15.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
