# passtra API — environment template. Copy to apps/api/.env for local development.
# Secrets live only on the server (this file or the hosting provider's environment), never in the app.
# docs/04-api-keys.md explains where to get each key and what it costs.

# ── Required ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://passtra:passtra@localhost:5432/passtra   # PostgreSQL 15+ with PostGIS 3 and pg_trgm
AUTH_JWT_SECRET=               # random string ≥ 32 chars; signs passtra's own sessions (changing it signs everyone out)
REPORT_SALT=                   # random string; hashes IPs for anonymous-report rate limiting

# ── Accounts & admins ────────────────────────────────────────────────────
ADMIN_USER_IDS=                # comma-separated user ids that are admins
ADMIN_EMAILS=                  # comma-separated e-mails that are admins once the e-mail is confirmed
RESEND_API_KEY=                # e-mail codes (confirm e-mail, password reset). Without it e-mail can't be confirmed
EMAIL_FROM=passtra <no-reply@passtra.app>   # sender on a domain verified in Resend
TWILIO_ACCOUNT_SID=            # SMS codes for phone numbers (optional)
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                   # Twilio number or approved sender id
DEV_SHOW_CODES=false           # development only: shows codes in the UI instead of sending; refused in production
# Optional external identity provider (JWKS) instead of / besides AUTH_JWT_SECRET:
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated

# ── Optional integrations (features degrade gracefully and say so) ──────
GOOGLE_MAPS_API_KEY=           # Places API (New) + Geocoding: photos, hours, ratings, address checks. Restrict to server IPs
ANTHROPIC_API_KEY=             # AI query interpretation, fact-only summaries, AI moderation; rules are used without it
ANTHROPIC_MODEL=claude-opus-5-5
AI_SEARCH_TIMEOUT_MS=2500
TICKETMASTER_API_KEY=          # Discovery API (free key)
EVENTBRITE_TOKEN=              # private token; add organisation ids to the source config in admin
EXPO_ACCESS_TOKEN=             # optional: enhanced push security in Expo
WEB_PUSH_PUBLIC_KEY=           # VAPID pair (npx web-push generate-vapid-keys); generated and stored in the DB if empty
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@passtra.app
ROUTING_URL=https://routing.openstreetmap.de   # OSRM-compatible routing (FOSSGIS by default, no SLA)
OVERPASS_URL=https://overpass-api.de/api/interpreter   # only for the optional Overpass import mode (places come from Geofabrik)
NOMINATIM_URL=https://nominatim.openstreetmap.org      # ≤1 req/s; self-host for volume
GEOCODING_ENABLED=true
BOT_USER_AGENT=passtra-bot/1.0 (+https://passtra.app/bot; data@passtra.app)

# ── Links & app stores ───────────────────────────────────────────────────
PUBLIC_WEB_URL=                # public address used in shared links and previews, e.g. https://passtra.onrender.com
APPLE_TEAM_ID=                 # iOS Universal Links (apple-app-site-association)
ANDROID_CERT_SHA256=           # Android App Links (assetlinks.json)
CORS_ORIGINS=                  # e.g. https://passtra.app,https://admin.passtra.app

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=false              # true behind a proxy (Render, Fly…)
DATABASE_POOL_MAX=10
RUN_WORKER=true                # run imports, reminders and maintenance inside the API process (single instance)
WORKER_POLL_MS=15000
APP_STATIC_DIR=                # web build of the app (apps/mobile/dist) served at /
ADMIN_STATIC_DIR=              # admin build (apps/admin/dist) served at /admin/
FEATURE_PROMOTIONS=false
DEMO_MODE=false                # never true in production (enforced)
