# ── Required ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://passtra:passtra@localhost:5432/passtra   # PostgreSQL 15+ with PostGIS 3
# Auth: Supabase project → Settings → API → JWT. Prefer JWKS (asymmetric keys); HS256 secret also works.
AUTH_JWKS_URL=                 # e.g. https://<project>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWT_SECRET=               # legacy HS256 JWT secret (dev/test or older projects)
AUTH_ISSUER=                   # e.g. https://<project>.supabase.co/auth/v1
ADMIN_USER_IDS=                # comma-separated auth user ids that become admins
REPORT_SALT=                   # random string; hashes IPs for anonymous-report rate limiting
CORS_ORIGINS=                  # e.g. https://passtra.app,https://admin.passtra.app

# ── Optional integrations (features degrade gracefully and say so) ──────
GOOGLE_MAPS_API_KEY=           # Places API (New) live enrichment; restrict to Places API + server IPs
ANTHROPIC_API_KEY=             # AI query interpretation; without it a deterministic parser is used
ANTHROPIC_MODEL=claude-opus-5-5
TICKETMASTER_API_KEY=          # Discovery API (free key)
EVENTBRITE_TOKEN=              # private token; add organisation ids to the source config in admin
EXPO_ACCESS_TOKEN=             # optional: enhanced push security in Expo
OVERPASS_URL=https://overpass-api.de/api/interpreter   # use your own Overpass instance at scale
NOMINATIM_URL=https://nominatim.openstreetmap.org      # ≤1 req/s; self-host for volume
GEOCODING_ENABLED=true
BOT_USER_AGENT=passtra-bot/1.0 (+https://passtra.app/bot; data@passtra.app)

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=true
ADMIN_STATIC_DIR=              # set to the admin build dir to serve /admin/
DEMO_MODE=false                # never true in production (enforced)
