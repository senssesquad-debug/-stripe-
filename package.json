{
  "name": "passtra",
  "private": true,
  "version": "0.1.0",
  "description": "passtra — discover what's happening around you, right now.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @passtra/api db:migrate",
    "dev:api": "pnpm --filter @passtra/api dev",
    "dev:worker": "pnpm --filter @passtra/api dev:worker",
    "dev:admin": "pnpm --filter @passtra/admin dev",
    "dev:mobile": "pnpm --filter @passtra/mobile start"
  }
}
